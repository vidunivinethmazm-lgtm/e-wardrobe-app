# Copy this file to ".env" and fill in your MongoDB Atlas connection string.
# If MONGODB_URI is left blank, the backend uses an in-memory store that
# resets every time it restarts.

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=e-wardrobe-ai
MONGODB_DB=ewardrobe
