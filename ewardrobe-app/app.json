{
  "expo": {
    "name": "eWardrobeAI",
    "slug": "ewardrobe-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0D0D14"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        { "cameraPermission": "Allow eWardrobeAI to access your camera for selfie capture." }
      ],
      [
        "expo-image-picker",
        { "photosPermission": "Allow eWardrobeAI to access your photos." }
      ]
    ],
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0D0D14"
      },
      "package": "com.ewardrobe.app"
    },
    "ios": {
      "bundleIdentifier": "com.ewardrobe.app",
      "supportsTablet": false
    },
    "scheme": "ewardrobe"
  }
}
